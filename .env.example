# Copy to .env.local for local dev. On Netlify these become site environment
# variables (Site settings -> Environment variables).
#
# VITE_ means "baked into the browser bundle". Only put public values here.

VITE_SHOPIFY_STORE=lex-valentina-customs.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2026-07

# The portfolio's metaobject type. App-owned, so its real name carries the
# app's id — it is configuration, not a constant we can hardcode.
VITE_SHOPIFY_PORTFOLIO_TYPE=app--420354064385--lexval_portfolio

# ------------------------------------------------------------------
# SERVER ONLY — no VITE_ prefix, so these never reach the browser.
# `netlify dev` reads them from a .env file here; on Netlify they go in
# Site settings -> Environment variables.
#
# Putting VITE_ in front of any of these would publish Lex's store
# credentials in the JavaScript bundle. There is no second safeguard.
# ------------------------------------------------------------------
SHOPIFY_STORE=lex-valentina-customs.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# The Studio. STUDIO_SECRET signs the session cookie — any long random string;
# changing it signs everyone out. PORTFOLIO_TYPE is the same value as
# VITE_SHOPIFY_PORTFOLIO_TYPE, without the prefix, because the functions need
# it too and they don't read VITE_ variables.
STUDIO_PASSWORD=
STUDIO_SECRET=
PORTFOLIO_TYPE=app--420354064385--lexval_portfolio
